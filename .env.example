# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# PostgreSQL. Locally: `npm run db:up` starts one in Docker with these values.
# On Vercel: connect a Postgres database (e.g. Neon, Frankfurt); it sets both variables for you.
DATABASE_URL="postgresql://nucleus:nucleus@localhost:5433/nucleus_fleet"
DATABASE_URL_UNPOOLED="postgresql://nucleus:nucleus@localhost:5433/nucleus_fleet"

SESSION_SECRET=""
FIELD_ENCRYPTION_KEY=""

# Local development stores uploads on disk. On Vercel, connect a PRIVATE Blob store instead
# (it sets BLOB_STORE_ID automatically). For a local test against a real store, set BLOB_READ_WRITE_TOKEN.
STORAGE_DIR="./storage/uploads"
BLOB_READ_WRITE_TOKEN=""

# Public address of the site (no trailing slash). Used for the Google sign-in redirect.
APP_URL="http://localhost:3000"

# Staff two-factor sign-in. Leave as "required". "optional" exists only for throwaway local development.
STAFF_2FA="required"

# Optional: "Continue with Google" for riders. Create an OAuth client (type: Web application) in Google Cloud Console
# and add ${APP_URL}/api/auth/google/callback as an authorised redirect URI. The button is hidden while these are empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
