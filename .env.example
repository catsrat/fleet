# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Required -------------------------------------------------------------------------------------

# PostgreSQL. Locally: `npm run db:up` starts one in Docker with these values.
# On Vercel: connect a Postgres database (e.g. Neon, Frankfurt); it sets both variables for you.
DATABASE_URL="postgresql://nucleus:nucleus@localhost:5433/nucleus_fleet"
DATABASE_URL_UNPOOLED="postgresql://nucleus:nucleus@localhost:5433/nucleus_fleet"

# Signs session cookies. Any long random string.
SESSION_SECRET=""
# Encrypts documents and payroll fields. EXACTLY 32 bytes, base64. Back this up: without it,
# every uploaded document is unreadable forever.
FIELD_ENCRYPTION_KEY=""

# Public address of the site, no trailing slash. Used in emails and the Google redirect.
APP_URL="http://localhost:3000"

# --- Storage --------------------------------------------------------------------------------------
# Local development writes encrypted files here. On Vercel, connect a PRIVATE Blob store instead
# (it sets BLOB_STORE_ID automatically). Set BLOB_READ_WRITE_TOKEN only to test a real store locally.
STORAGE_DIR="./storage/uploads"
BLOB_READ_WRITE_TOKEN=""

# --- First administrator --------------------------------------------------------------------------
# Any long random string. Lets you create the owner account once at /setup; that page closes itself
# permanently as soon as a staff account exists. Leave empty to switch the page off entirely.
SETUP_TOKEN=""

# --- Email (rider notifications and password reset) -----------------------------------------------
# Without a key the app still runs: messages are written to the log instead of being sent.
# Create a key at https://resend.com, verify your sending domain, then set both.
RESEND_API_KEY=""
EMAIL_FROM="Nucleus Fleet <riders@yourdomain.de>"

# --- Scheduled clean-up ---------------------------------------------------------------------------
# Vercel Cron calls /api/cron/retention daily with this as a bearer token. Without it the route is shut.
CRON_SECRET=""
# Days after which a rejected applicant's uploaded files are erased (their record and the audit trail stay).
RETENTION_DAYS="180"

# --- Optional -------------------------------------------------------------------------------------
# Staff two-factor sign-in. Leave as "required"; "optional" exists only for throwaway local development.
STAFF_2FA="required"

# "Continue with Google" for riders. Create an OAuth client (type: Web application) in Google Cloud
# Console and add ${APP_URL}/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack or Discord incoming webhook. Server errors are posted here as well as to the platform log.
ERROR_WEBHOOK_URL=""
