# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL="file:./dev.db"
SESSION_SECRET=""
FIELD_ENCRYPTION_KEY=""
STORAGE_DIR="./storage/uploads"

# Public address of the site (no trailing slash). Used for the Google sign-in redirect.
APP_URL="http://localhost:3000"

# Staff two-factor sign-in. Leave as "required". "optional" exists only for throwaway local development.
STAFF_2FA="required"

# Optional: "Continue with Google" for riders. Create an OAuth client (type: Web application) in Google Cloud Console
# and add ${APP_URL}/api/auth/google/callback as an authorised redirect URI. The button is hidden while these are empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
