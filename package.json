{
  "name": "nucleus-fleet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed:demo": "node --env-file=.env --import tsx prisma/seed.ts --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "owner:setup": "node --env-file=.env --import tsx scripts/owner-setup.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate deploy",
    "db:dev": "prisma generate && prisma migrate dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "22.x"
  }
}
