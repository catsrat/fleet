{
  "name": "nucleus-fleet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:demo": "node --env-file=.env --import tsx prisma/seed.ts --demo",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
